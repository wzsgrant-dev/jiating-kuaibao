---
layout: base.njk
title: 莲tara
isHome: true
permalink: /
---
<section class="hero">
  <div class="wrap">
    <p class="seal" aria-hidden="true">{{ site.nameHan }}</p>
    <h1>{{ site.title | brand | safe }}</h1>
    <p class="subtitle">{{ site.subtitleLead }}{{ site.subtitleTail }}</p>
  </div>
</section>

{% if books.length %}
<section class="serial" aria-label="连载">
  {% for book in books %}
  {% set chapters = collections.chapters | bookChapters(book.id) %}
  {% set latest = chapters | last %}
  <article class="serial-card">
    <div class="wrap">
      {% if book.sample %}<p class="sample-flag">示例</p>{% endif %}
      <h2>连载：《{{ book.title }}》</h2>
      {% if book.author %}<p class="serial-author">作者：{{ book.author }}</p>{% endif %}
      {% if book.translatorNote %}<p class="serial-note">{{ book.translatorNote }}</p>{% endif %}
      {% if latest %}
      <p class="serial-latest">第{{ latest.data.chapter }}章 · {{ latest.data.title }}</p>
      <a class="home-button" href="{{ latest.url | unprefix }}">继续读第{{ latest.data.chapter }}章</a>
      {% else %}
      <p class="serial-note">还没有章节。</p>
      {% endif %}
      <a class="button-quiet" href="/books/{{ book.id }}/">目录</a>
    </div>
  </article>
  {% endfor %}
</section>
{% endif %}

<section class="feed" aria-label="资讯">
  <div class="wrap feed-label">
    <h2>资讯</h2>
  </div>
  {% set posts = collections.posts %}
  {% set eagerCover = posts | firstCoverUrl %}
  {% for post in posts %}
  <article class="story{% if not post.data.cover %} story-plain{% endif %} reveal"{% if post.data.category %} data-category="{{ post.data.category }}"{% endif %}>
    <a class="story-link" href="{{ post.url | unprefix }}">
      {% if post.data.cover %}
      <div class="story-photo">
        <img
          src="{{ post.inputPath | coverSrc(post.data.cover) }}"
          alt="{{ post.data.coverAlt }}"
          {% if post.url == eagerCover %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
          decoding="async"
          sizes="100vw"
        >
      </div>
      {% endif %}
      <div class="wrap story-copy">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | zhDate }}</time>
        <h2>{{ post.data.title | brand | safe }}</h2>
        <p>{{ post | autoExcerpt }}</p>
        <p class="more">阅读全文</p>
      </div>
    </a>
  </article>
  {% else %}
  <div class="wrap empty">
    <p>还没有文章。</p>
  </div>
  {% endfor %}
</section>
