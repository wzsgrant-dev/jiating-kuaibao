---
layout: base.njk
---
{% set meta = books | bookMeta(book) %}
{% set series = collections.chapters | bookChapters(book) %}
{% set nav = series | chapterNav(page.url) %}
<article class="chapter">
  <header class="wrap chapter-head">
    {% if meta.sample %}<p class="sample-flag">示例</p>{% endif %}
    <p class="chapter-kicker"><a href="/books/{{ book }}/">连载：《{{ meta.title }}》</a></p>
    <h1>第{{ chapter }}章 · {{ title }}</h1>
    <time datetime="{{ page.date | isoDate }}">{{ page.date | zhDate }}</time>
  </header>

  {% include "bilibili.njk" %}

  <div class="wrap post-body">
    {{ content | safe }}
  </div>

  <nav class="wrap chapter-nav" aria-label="章节">
    {% if nav.prev %}
    <a class="home-button" href="{{ nav.prev.url | unprefix }}">上一章</a>
    {% else %}
    <span class="home-button is-disabled" aria-disabled="true">上一章</span>
    {% endif %}
    {% if nav.next %}
    <a class="home-button" href="{{ nav.next.url | unprefix }}">下一章</a>
    {% else %}
    <span class="home-button is-disabled" aria-disabled="true">下一章</span>
    {% endif %}
    <a class="button-quiet" href="/books/{{ book }}/">目录</a>
  </nav>
</article>
