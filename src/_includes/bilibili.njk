{% if bvid %}
{% set vid = bvid | safeBvid %}
<div class="bilibili">
  <div class="bilibili-frame">
    <iframe
      src="https://player.bilibili.com/player.html?bvid={{ vid }}&autoplay=0&danmaku=0"
      title="B站视频"
      loading="lazy"
      allowfullscreen
      allow="fullscreen"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <div class="wrap">
    <p class="bilibili-open"><a href="https://www.bilibili.com/video/{{ vid }}">在B站打开</a></p>
  </div>
</div>
{% endif %}
